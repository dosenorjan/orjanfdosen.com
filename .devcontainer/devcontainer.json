{
  "name": "Ørjan F. Døsen — Artist Site",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Artist site",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "pkill -f \"python3 -m http.server 8000\" || true; python3 -m http.server 8000 --bind 0.0.0.0 >/tmp/orjanfdosen-preview.log 2>&1 &"
}
