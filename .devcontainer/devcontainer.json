{
  "name": "Ørjan F. Døsen — Artist Site",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Artist site",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "pkill -f \"python3 -m http.server 3000\" || true; python3 -m http.server 3000 --bind 0.0.0.0 >/tmp/orjanfdosen-preview.log 2>&1 &"
}
